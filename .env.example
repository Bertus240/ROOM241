# Configuration API Strava (Studio ROOM241)
# Ces clés doivent être créées sur https://www.strava.com/settings/api
# NE JAMAIS COMMITER CE FICHIER AVEC DE VRAIES VALEURS

# Identifiant de l'application API Strava (accessible dans vos paramètres API)
STRAVA_CLIENT_ID=

# Secret client de l'application (strictement confidentiel, ne jamais exposer côté client)
STRAVA_CLIENT_SECRET=

# Jeton de rafraîchissement permanent obtenu lors du consentement OAuth2 initial
# Scope requis : activity:read_all
STRAVA_REFRESH_TOKEN=

# Seuil de validation hebdomadaire (à définir selon vos critères d'entraînement) :
# - 'any_run' : au moins 1 sortie course à pied
# - 'min_distance_km' : distance minimale hebdomadaire (ex: 5)
# - 'min_time_min' : durée active minimale (ex: 30)
STRAVA_VALIDATION_CRITERIA=any_run

